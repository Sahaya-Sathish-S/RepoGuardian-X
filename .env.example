# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
PORT=10000

# Supabase: Project Settings -> API. The anon/publishable key is intended for browser use.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# AI: configure one provider. Server-side keys only; never commit real keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Stripe subscriptions. Create recurring Prices in Stripe and copy their IDs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=
